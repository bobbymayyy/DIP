[Unit]
Description=DIPx STOKER controller bootstrap
After=network-online.target open-vm-tools.service
Wants=network-online.target
ConditionPathExists=!/home/stoker/.local/state/dipx/controller-ready

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/dipx-controller-bootstrap
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
